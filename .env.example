# Copy this to `.env` and fill in your local secrets.

LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
# CREWMATE_LLM_MODEL=gemini-3.5-flash
# IMPOSTOR_LLM_MODEL=gemini-3.5-flash
# CREWMATE_LLM_MODELS=gemini-3.5-flash,gemini-2.5-flash
# IMPOSTOR_LLM_MODELS=gemini-3.5-flash,gemini-2.5-flash
# LLM_MAX_TOKENS=1024
# Prompt-context windows for recent in-game evidence.
LLM_RECENT_OBSERVATIONS=40
LLM_RECENT_ACTIONS=10

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LOBBY_COUNTDOWN_SECONDS=60
# Before there is enough human behavior to estimate a pace, each AI makes a map
# decision at this interval. It then follows the observed average human action interval.
AI_INITIAL_ACTION_INTERVAL_SECONDS=12
AI_MIN_ACTION_INTERVAL_SECONDS=2
AI_MAX_ACTION_INTERVAL_SECONDS=60
# Time each human or AI task step takes before it is completed.
TASK_DURATION_SECONDS=20
# Wall-clock cooldowns for impostor map actions.
KILL_COOLDOWN_SECONDS=20
VENT_COOLDOWN_SECONDS=20
# Wall-clock match duration. When it reaches zero, the impostors win.
MATCH_DURATION_SECONDS=500
# Shared free-chat discussion window and the following voting window, in seconds.
MEETING_DISCUSSION_SECONDS=60
MEETING_VOTING_SECONDS=60
# Destination participants use after a completed match, for example a SONA or survey completion URL.
# Leave blank to hide the post-game participation button.
PARTICIPATION_COMPLETION_URL=
# EXPERIMENT_PATH=
