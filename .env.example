# Copy this to `.env` and fill in your local secrets.

LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
# CREWMATE_LLM_MODEL=gemini-3.5-flash
# IMPOSTOR_LLM_MODEL=gemini-3.5-flash
# CREWMATE_LLM_MODELS=gemini-3.5-flash,gemini-2.5-flash
# IMPOSTOR_LLM_MODELS=gemini-3.5-flash,gemini-2.5-flash
# LLM_MAX_TOKENS=1024

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LOBBY_COUNTDOWN_SECONDS=60
# Shared free-chat discussion window and the following voting window, in seconds.
ROUND_DURATION_SECONDS=30
MEETING_DISCUSSION_SECONDS=60
MEETING_VOTING_SECONDS=60
# Destination participants use after a completed match, for example a SONA or survey completion URL.
# Leave blank to hide the post-game participation button.
PARTICIPATION_COMPLETION_URL=
# EXPERIMENT_PATH=
